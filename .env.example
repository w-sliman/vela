OPENAI_BASE_URL=
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=
OPENAI_API_MODE=auto
VELA_WORKSPACE=./workspace
VELA_APPROVAL_MODE=prompt
VELA_MAX_TOOL_OUTPUT=12000
VELA_MAX_FILE_CHARS=30000
VELA_COMMAND_TIMEOUT=45
VELA_ENABLE_BROWSER=0
VELA_ENABLE_GITHUB=0
VELA_ENABLE_SANDBOX=0
VELA_TELEMETRY=1
VELA_DEBUG=0

VELA_INPUT_PRICE_PER_MILLION=0
VELA_OUTPUT_PRICE_PER_MILLION=0
# Model context window in tokens. Drives the context budget that decides when the
# conversation must be reduced. Leave it commented out to let the agent work it
# out: it probes local servers that report their window (vLLM, llama.cpp, Ollama)
# and otherwise learns the real limit from the first oversized-request rejection,
# caching it per endpoint+model. Setting it here skips probing — but a server
# rejection still overrides it, because the server is never wrong about its own
# ceiling.
# VELA_CONTEXT_WINDOW=128000
# Retry failed model requests (exponential backoff: 0.5s, 1s, ...).
VELA_REQUEST_RETRIES=2
# Reduce the conversation whenever the outgoing payload would not fit the context
# budget: summarize older turns, dropping the oldest only if summarizing fails.
# 0 disables reduction entirely (requests may then be rejected as too large).
VELA_AUTO_COMPACT=1
# How many recent user-turns a compaction keeps verbatim. The operator owns this,
# not the summarizer: keeping only 1 leaves too little history for the next
# compaction to run, which forces every later reduction onto a blunter method.
VELA_COMPACT_KEEP_TURNS=3
# Tokens held back from the window for the model's reply. 0 = window/8.
VELA_REPLY_RESERVE_TOKENS=0
# Stream assistant text tokens live (chat transport).
VELA_STREAM=1
# Commit a git checkpoint after each successful edit, enabling /undo.
VELA_AUTO_CHECKPOINT=1
# Lexical memory injection: retrieve relevant project memories per user request
# and attach them as advisory context. 0 disables; the rest tune selection.
VELA_MEMORY_INJECT=1
VELA_MEMORY_TOPK=4
VELA_MEMORY_MAX_CHARS=1500
VELA_MEMORY_MIN_SCORE=0.5
# /compact distillation: persist durable facts/decisions proposed by the summarizer.
VELA_MEMORY_DISTILL=1
# Memory curation: hard cap on stored records (coldest dropped first on write)
# and optional staleness expiry in days (0 = never expire).
VELA_MEMORY_MAX_RECORDS=200
VELA_MEMORY_TTL_DAYS=0
# Visible working todo list for non-trivial tasks (rendered live, re-injected
# into every request so it survives context reduction).
VELA_TODOS=1
# Before finishing a request, nudge the model once if todos are open or edits were
# not followed by a passing check. On by default: measured against the same task
# with it off, the model edited a file and declared itself done without running
# anything; with it on, it ran the tests. Costs at most one extra check per
# request. 0 disables.
VELA_VERIFY_GATE=1
# Character budget for the digest /resume builds from a past session trace.
VELA_RESUME_MAX_CHARS=6000
# Ask for confirmation (showing the computed diff) before every file edit.
VELA_APPROVAL_EDITS=0
# Optional token for github_get; only used when VELA_ENABLE_GITHUB=1.
GITHUB_TOKEN=
# Allow the network tools to reach loopback/private/link-local addresses. Off by
# default: URLs come from the model, which reads untrusted repository content, so
# cloud metadata (169.254.169.254) and services on your machine are refused.
VELA_ALLOW_PRIVATE_URLS=0
# Deny shell commands that reach the network (curl, wget, urllib, pip install,
# git clone, ...) and tell the model the environment has no egress. Left on by
# default: package installs and fetches are ordinary development commands. Turn
# it off in a sandbox that genuinely has no network -- otherwise the model
# discovers the fact one failed command at a time and keeps trying new ones.
VELA_SHELL_NETWORK=1
